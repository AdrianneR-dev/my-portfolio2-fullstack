# MongoDB Atlas connection string (get from Atlas > Connect > Drivers)
# Must include the database name, e.g. .../my-portfolio2?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/my-portfolio2?retryWrites=true&w=majority

# Long, random secret used to sign JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=2h

# Comma-separated list of allowed frontend origins (no trailing slash)
CORS_ORIGIN=http://localhost:5173,https://your-frontend.vercel.app

PORT=5000
NODE_ENV=development

# One-time bootstrap admin, used only by scripts/seed.js.
# Change the password immediately after first login in production.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-now-123!
